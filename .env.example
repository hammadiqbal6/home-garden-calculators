# Build-time / deploy env vars read by this repo (import.meta.env or process.env).
# Copy to `.env` for local builds. Cloudflare Workers Builds: Settings → Build → Variables.
# All values below are public (site URL, analytics IDs, IndexNow key). No secrets.
# Full table: docs/CONFIGURATION.md. Custom domain: docs/CUSTOM-DOMAIN.md.

# Canonical site origin (https, no trailing slash). Drives sitemap, canonicals, robots, llms.txt,
# OG, JSON-LD, IndexNow. Leave empty to use DEFAULT_SITE_URL in src/config/siteDefaults.mjs.
PUBLIC_SITE_URL=https://getyardtally.com

# Brand identity (defaults match YardTally production).
PUBLIC_SITE_NAME=YardTally
PUBLIC_SITE_SHORT_NAME=YardTally
PUBLIC_SITE_TAGLINE=Free home & garden material calculators
PUBLIC_MANIFEST_DESCRIPTION=Free home and garden material calculators

# Sister-site origins (same names on all five repos). Used for About + sparing topical cross-links.
# HOME_GARDEN empty → same origin as PUBLIC_SITE_URL / siteDefaults.mjs.
PUBLIC_SITE_URL_PAYMENT_FEES=https://payment-fee-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_BUSINESS_DOCS=https://docuklin.com
PUBLIC_SITE_URL_HOME_GARDEN=https://getyardtally.com
PUBLIC_SITE_URL_FIBER_ARTS=https://fiber-arts-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_PET=https://pet-calculators.hammadiqbal117.workers.dev

# Optional About sibling display names.
# PUBLIC_SISTER_NAME_PAYMENT_FEES=FeeCalc
# PUBLIC_SISTER_NAME_BUSINESS_DOCS=Docuklin
# PUBLIC_SISTER_NAME_FIBER_ARTS=FiberCalc
# PUBLIC_SISTER_NAME_PET=PetCalc Tools

# Public contact email for mailto, trust pages, and Organization JSON-LD.
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# Footer © owner; empty → site name.
# PUBLIC_COPYRIGHT_OWNER=

# Author byline name on tools/guides/about (defaults to Hammad Iqbal).
PUBLIC_AUTHOR_NAME=Hammad Iqbal

# Author bio (`{name}` → site name). Honest one-person copy; no fake credentials.
PUBLIC_AUTHOR_BIO=I build and maintain {name} as a one-person project: free home and garden material calculators with documented formulas, manufacturer bag yields, and university extension guidance. I am not a licensed contractor or engineer—results are planning estimates you should check against local building codes and product labels.

# Theme / manifest colors.
# PUBLIC_THEME_COLOR=#1f6b4a
# PUBLIC_BACKGROUND_COLOR=#f3f6f2

# Google Analytics 4 measurement ID. Empty disables gtag. Loaded deferred + Consent Mode v2.
PUBLIC_GA4_MEASUREMENT_ID=G-N4VRDDEVLP

# Google Search Console HTML-tag verification "content" value. Do not remove if set in deploy env.
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU

# Legacy alias for PUBLIC_GSC_VERIFICATION (older Workers Builds configs). Prefer PUBLIC_GSC_VERIFICATION.
PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 content (optional). Leave empty if unused; do not invent.
PUBLIC_BING_SITE_VERIFICATION=

# AdSense publisher ID (ca-pub-… or pub-…). Leave empty until approved — ads stay off.
# When set, /ads.txt emits: google.com, pub-XXXX, DIRECT, f08c47fec0942fa0
PUBLIC_ADSENSE_PUBLISHER_ID=

# AdSense master switch; must be exactly "true" AND a real publisher id before ad scripts load.
PUBLIC_ADSENSE_ENABLED=

# Fixed in-page ad unit IDs (numeric only, from AdSense → Ads → By ad unit).
# Leave empty to omit fixed <ins> slots so Auto ads can fill the page alone.
# PUBLIC_ADSENSE_SLOT_DISPLAY is the primary calculator mid-page unit.
# Optional per-placement overrides (top / mid / bottom) fall back to DISPLAY.
PUBLIC_ADSENSE_SLOT_DISPLAY=
# PUBLIC_ADSENSE_SLOT_TOP=
# PUBLIC_ADSENSE_SLOT_MID=
# PUBLIC_ADSENSE_SLOT_BOTTOM=

# EmailJS (FREE plan) for /contact/ form — public IDs only. Leave empty to show mailto fallback.
# Never put the EmailJS private key here or in the repo. See docs/CONTACT-EMAILJS.md.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=

# IndexNow API key (also committed as public/<key>.txt). Override for scripts/indexnow.mjs.
INDEXNOW_KEY=c2a68b8b8e7e6ba2253b408fa0fe2c4c
# PUBLIC_INDEXNOW_KEY=

# Set to 1 to skip IndexNow ping (deploy still succeeds). Leave unset for normal pings.
INDEXNOW_DISABLE=

# --- Worker runtime (wrangler.jsonc vars / Cloudflare Worker Variables — NOT PUBLIC_*) ---
# CANONICAL_ORIGIN=https://getyardtally.com
# LEGACY_REDIRECT_HOSTS=www.getyardtally.com
