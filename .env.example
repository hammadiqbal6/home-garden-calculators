# Build-time / deploy env vars read by this repo (import.meta.env or process.env).
# Copy to `.env` for local builds. Cloudflare Workers Builds: Settings → Build → Variables.
# All values below are public (site URL, analytics IDs, IndexNow key). No secrets.

# Canonical site origin (https, no trailing slash). Drives sitemap, canonicals, robots, llms.txt,
# OG, JSON-LD, IndexNow. Leave empty to use DEFAULT_SITE_URL in src/config/site-origin.mjs.
# Custom domain cutover: docs/CUSTOM-DOMAIN.md — set this to https://www.your-domain.com (no slash).
PUBLIC_SITE_URL=

# Sister-site origins (same names on all five repos). Used for About + sparing topical cross-links.
# Switch to custom domains later without code changes. Fallbacks live in src/config/sisterSites.ts.
# HOME_GARDEN empty → same origin as PUBLIC_SITE_URL / site-origin.mjs (do not paste this host).
PUBLIC_SITE_URL_PAYMENT_FEES=https://payment-fee-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_BUSINESS_DOCS=https://business-document-generators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_HOME_GARDEN=
PUBLIC_SITE_URL_FIBER_ARTS=https://fiber-arts-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL_PET=https://pet-calculators.hammadiqbal117.workers.dev

# Public contact email for mailto, trust pages, and Organization JSON-LD.
PUBLIC_CONTACT_EMAIL=hammadiqbal117@gmail.com

# Author byline name on tools/guides/about (defaults to Hammad Iqbal).
PUBLIC_AUTHOR_NAME=Hammad Iqbal

# Author bio on tools/guides/about (honest one-person copy; no fake credentials).
PUBLIC_AUTHOR_BIO=I build and maintain YardCalc as a one-person project: free home and garden material calculators with documented formulas, manufacturer bag yields, and university extension guidance. I am not a licensed contractor or engineer—results are planning estimates you should check against local building codes and product labels.

# Google Analytics 4 measurement ID. Empty disables gtag. Loaded deferred + Consent Mode v2.
PUBLIC_GA4_MEASUREMENT_ID=G-N4VRDDEVLP

# Google Search Console HTML-tag verification "content" value. Do not remove if set in deploy env.
PUBLIC_GSC_VERIFICATION=0-q_NxhBgfgCm4WOLfbe9VrHrjbLzaxh8SXsbo2Q-UU

# Legacy alias for PUBLIC_GSC_VERIFICATION (older Workers Builds configs). Prefer PUBLIC_GSC_VERIFICATION.
PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 content (optional). Leave empty if unused; do not invent.
PUBLIC_BING_SITE_VERIFICATION=

# AdSense publisher ID (ca-pub-…). Leave empty until approved — ads stay off.
PUBLIC_ADSENSE_PUBLISHER_ID=

# AdSense master switch; must be exactly "true" AND a real publisher id before ad scripts load.
PUBLIC_ADSENSE_ENABLED=

# IndexNow API key (also committed as public/<key>.txt). Override for scripts/indexnow.mjs.
INDEXNOW_KEY=c2a68b8b8e7e6ba2253b408fa0fe2c4c

# Set to 1 to skip IndexNow ping (deploy still succeeds). Leave unset for normal pings.
INDEXNOW_DISABLE=
