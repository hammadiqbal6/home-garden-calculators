# Build-time env vars read by Astro / src/config/site.ts.
# Copy to `.env` for local builds. Cloudflare Workers Builds: set under
# Settings → Build → Variables and secrets. No secrets belong here — all are PUBLIC_*.

# Canonical site origin (https, no trailing slash). Optional.
# Used for sitemap, canonicals, robots.txt, llms.txt. Falls back to the workers.dev URL.
# Example: https://home-garden-calculators.hammadiqbal117.workers.dev
PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID. Optional — leave empty to emit no gtag/analytics code.
# Example: G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console HTML-tag verification "content" value. Optional (DNS verify is fine).
# Example: abcDEF123_verification_token
PUBLIC_GSC_VERIFICATION=

# Google AdSense publisher ID. Optional — leave empty until approved.
# Example: ca-pub-1234567890123456
PUBLIC_ADSENSE_PUBLISHER_ID=

# Master AdSense switch. Optional — must be exactly "true" AND a real PUBLIC_ADSENSE_PUBLISHER_ID
# (not a ca-pub-XXXX placeholder) before any ad scripts load. Default: off.
# Example: true
PUBLIC_ADSENSE_ENABLED=
