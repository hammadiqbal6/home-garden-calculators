        "mainEntity": [
          {
            "@type": "Question",
            "name": "How many 80 lb bags of concrete in a yard?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "One cubic yard is 27 cubic feet. At about 0.60 cu ft per 80 lb bag, you need roughly 45 bags per cubic yard (27 ÷ 0.60), before waste."
            }
          },
          {
            "@type": "Question",
            "name": "Should I order ready-mix or use bags?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Bags are practical under about 1 cubic yard. Larger pours are usually cheaper and more consistent with ready-mix delivered by the yard."
            }
          },
          {
            "@type": "Question",
            "name": "How thick should a concrete slab be?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Many residential patio and shed slabs use 4 inches. Driveways and heavier loads often need 5–6 inches plus proper base—confirm with local code."
            }
          },
          {
            "@type": "Question",
            "name": "What waste factor should I use?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A 5–10% waste factor covers uneven subgrade, spillage, and over-excavation. Use 10% for DIY bag mixes and irregular forms."
            }
          }
        ]
      }
