---
import { siteConfig } from '../config/site';
import {
  resolveAdsenseSlotId,
  type AdSlotPosition,
} from '../lib/adsenseSlots';

interface Props {
  /** Placement hint for CSS / future per-slot env overrides. */
  position?: AdSlotPosition;
}
const { position = 'mid' } = Astro.props;

const slotId = resolveAdsenseSlotId(position, siteConfig.adsense.slots);
const enabled =
  siteConfig.adsense.enabled &&
  siteConfig.adsense.publisherId.startsWith('ca-pub-') &&
  !siteConfig.adsense.publisherId.includes('XXXX') &&
  Boolean(slotId);
---

{
  enabled ? (
    <>
      <aside
        class="ad-slot"
        data-position={position}
        aria-label="Advertisement"
        style="min-height: var(--ad-slot-h);"
      >
        <ins
          class="adsbygoogle"
          style="display:block;min-height:var(--ad-slot-h);width:100%"
          data-ad-client={siteConfig.adsense.publisherId}
          data-ad-slot={slotId}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      </aside>
      <script is:inline>
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {}
      </script>
    </>
  ) : null
}
