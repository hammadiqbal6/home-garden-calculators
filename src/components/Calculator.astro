---
import { defaultResultRows, ssrFields } from '../data/calculatorFields';

interface Props {
  calculatorId: string;
  embed?: boolean;
}
const { calculatorId, embed = false } = Astro.props;
const fields = ssrFields[calculatorId] ?? [];
const resultPlaceholders = defaultResultRows[calculatorId] ?? [
  ['Result', '—'],
];
---

<div
  class:list={['calc-root', embed && 'calc-embed']}
  data-calculator={calculatorId}
  data-embed={embed ? 'true' : 'false'}
>
  <div class="unit-toggle" role="group" aria-label="Unit system">
    <button type="button" data-units="imperial" aria-pressed="true">US</button>
    <button type="button" data-units="metric" aria-pressed="false">Metric</button>
  </div>
  <div class="calc-fields">
    <div class="field-grid cols-2">
      {
        fields.map((field) => (
          <div
            class="field"
            data-field={field.name}
            hidden={
              (calculatorId === 'concrete' &&
                ['steps', 'riser', 'tread'].includes(field.name)) ||
              (calculatorId === 'sonotube' &&
                ['bellDiameter', 'bellHeight', 'padDiameter', 'padThickness'].includes(field.name)) ||
              (calculatorId === 'lumber' && field.name === 'boardFeet') ||
              (calculatorId === 'footing' &&
                ['longBars', 'spacing', 'barSize', 'stick', 'rebarWaste'].includes(field.name)) ||
              (calculatorId === 'concrete-slab-cost' &&
                ['bagSize', 'bagPrice'].includes(field.name))
            }
          >
            <label for={`${calculatorId}-${field.name}`}>{field.label}</label>
            {field.type === 'select' && field.options ? (
              <select id={`${calculatorId}-${field.name}`} name={field.name}>
                {field.options.map((opt) => (
                  <option value={opt.value} selected={opt.value === field.value}>
                    {opt.label}
                  </option>
                ))}
              </select>
            ) : (
              <input
                id={`${calculatorId}-${field.name}`}
                name={field.name}
                type="number"
                inputmode="decimal"
                step={field.step || 'any'}
                min="0"
                value={field.value}
                required={!field.optional}
              />
            )}
            {field.hint && <p class="hint">{field.hint}</p>}
          </div>
        ))
      }
    </div>
  </div>
  <div class="results" aria-live="polite" aria-atomic="true" role="region" aria-label="Calculation results">
    <h2>Results</h2>
    <p class="hint results-example-note">
      Worked example from the default inputs above—values update live when you change a field.
    </p>
    <dl class="results-dl">
      {
        resultPlaceholders.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))
      }
    </dl>
    <div class="results-actions">
      <button type="button" class="btn btn-secondary" data-action="copy">Copy results</button>
      <button type="button" class="btn btn-secondary" data-action="share">Share link</button>
      <button type="button" class="btn btn-secondary" data-action="print">Print</button>
    </div>
  </div>
  <p class="field hint calc-error" id={`${calculatorId}-calc-error`} role="alert" hidden></p>
</div>

<script>
  import {
    asphaltTons,
    concreteCostCompare,
    bedMulch,
    deckFootings,
    concreteSlabCost,
    deckMaterials,
    fenceMaterials,
    fertilizerNeeded,
    footingRebar,
    footingVolume,
    formatUsd,
    grassSeed,
    frenchDrainMaterials,
    gravelVolume,
    LUMBER_DENSITY_PRESETS,
    lumberFromBoardFeet,
    lumberFromPieces,
    lumberWeight,
    masonryUnits,
    paintNeeded,
    paverCount,
    postHoleVolume,
    raisedBedSoil,
    rebarForSlab,
    retainingWallBlocks,
    roofingSquares,
    roofPitch,
    sandVolume,
    slabVolume,
    mixedSonotubeVolume,
    stepsVolume,
    topsoilVolume,
    treeRingMulch,
    type BagSizeLb,
    type RebarSize,
  } from '../lib/calculators';

  type Units = 'imperial' | 'metric';

  type Field = {
    name: string;
    label: string;
    type?: 'number' | 'select';
    options?: { value: string; label: string }[];
    step?: string;
    min?: string;
    imperialDefault: string;
    metricDefault: string;
    imperialHint?: string;
    metricHint?: string;
    /** Empty / zero allowed (convertTons, local prices). */
    optional?: boolean;
  };

  const bulkOptionalFields = (): Field[] => [
    {
      name: 'convertTons',
      label: 'Convert tons → yards (optional)',
      imperialDefault: '',
      metricDefault: '',
      imperialHint: 'leave blank to skip',
      metricHint: 'leave blank to skip',
      optional: true,
    },
    {
      name: 'pricePerYard',
      label: 'Price per cu yd (optional)',
      imperialDefault: '',
      metricDefault: '',
      imperialHint: 'your local quote',
      metricHint: 'your local quote',
      optional: true,
    },
    {
      name: 'pricePerTon',
      label: 'Price per ton (optional)',
      imperialDefault: '',
      metricDefault: '',
      imperialHint: 'your local quote',
      metricHint: 'your local quote',
      optional: true,
    },
    {
      name: 'pricePerBag',
      label: 'Price per 0.5 cu ft bag (optional)',
      imperialDefault: '',
      metricDefault: '',
      imperialHint: 'your local quote',
      metricHint: 'your local quote',
      optional: true,
    },
  ];

  function bulkResultRows(r: {
    areaSqFt: number;
    volumeCuFt: number;
    volumeCuYd: number;
    volumeCuM: number;
    tons?: number;
    tonsFromYards?: number;
    yardsFromTons?: number;
    bags05CuFt?: number;
    costYards?: number;
    costTons?: number;
    costBags?: number;
    cheapestLabel?: 'yard' | 'ton' | 'bags';
    cheapestCost?: number;
  }): [string, string][] {
    const rows: [string, string][] = [
      ['Area', `${r.areaSqFt} sq ft`],
      ['Volume', `${r.volumeCuFt} cu ft (${r.volumeCuYd} cu yd / ${r.volumeCuM} m³)`],
    ];
    if (r.tonsFromYards != null) rows.push(['Tons from yards', String(r.tonsFromYards)]);
    else if (r.tons != null) rows.push(['Est. tons', String(r.tons)]);
    if (r.yardsFromTons != null) rows.push(['Yards from tons', String(r.yardsFromTons)]);
    if (r.bags05CuFt != null) rows.push(['0.5 cu ft bags', String(r.bags05CuFt)]);
    if (r.costYards != null) rows.push(['Bulk cost (by yard)', `$${r.costYards}`]);
    if (r.costTons != null) rows.push(['Bulk cost (by ton)', `$${r.costTons}`]);
    if (r.costBags != null) rows.push(['Bag cost', `$${r.costBags}`]);
    if (r.cheapestLabel && r.cheapestCost != null) {
      const label =
        r.cheapestLabel === 'yard' ? 'bulk by yard' : r.cheapestLabel === 'ton' ? 'bulk by ton' : 'bags';
      rows.push(['Cheaper option', `${label} ($${r.cheapestCost})`]);
    }
    return rows;
  }

  function mulchResultRows(r: {
    areaSqFt: number;
    volumeCuFt: number;
    volumeCuYd: number;
    volumeCuM: number;
    bags2CuFt: number;
    bags3CuFt: number;
    costYards?: number;
    costBags2?: number;
    costBags3?: number;
  }): [string, string][] {
    const rows: [string, string][] = [
      ['Area', `${r.areaSqFt} sq ft`],
      ['Volume', `${r.volumeCuFt} cu ft (${r.volumeCuYd} cu yd / ${r.volumeCuM} m³)`],
      ['2 cu ft bags', String(r.bags2CuFt)],
      ['3 cu ft bags', String(r.bags3CuFt)],
    ];
    if (r.costYards != null) rows.push(['Bulk cost (by yard)', `$${r.costYards}`]);
    if (r.costBags2 != null) rows.push(['2 cu ft bag cost', `$${r.costBags2}`]);
    if (r.costBags3 != null) rows.push(['3 cu ft bag cost', `$${r.costBags3}`]);
    return rows;
  }

  type CalculatorConfig = {
    fields: Field[];
    compute: (values: Record<string, number>, units: Units) => [string, string][];
  };

  const lengthUnit = (u: Units) => (u === 'imperial' ? 'ft' : 'm');
  const smallLengthUnit = (u: Units) => (u === 'imperial' ? 'in' : 'cm');

  function bulkConfig(kind: 'gravel' | 'topsoil' | 'sand'): CalculatorConfig {
    return {
      fields: [
        {
          name: 'length',
          label: 'Length',
          imperialDefault: '20',
          metricDefault: '6',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        {
          name: 'width',
          label: 'Width',
          imperialDefault: '10',
          metricDefault: '3',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        {
          name: 'depth',
          label: 'Depth',
          imperialDefault: kind === 'sand' ? '1' : '4',
          metricDefault: kind === 'sand' ? '2.5' : '10',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        { name: 'waste', label: 'Waste / compaction %', imperialDefault: '10', metricDefault: '10' },
        ...bulkOptionalFields(),
      ],
      compute(v, u) {
        const depthInches = u === 'imperial' ? v.depth : v.depth / 2.54;
        const fn = kind === 'gravel' ? gravelVolume : kind === 'topsoil' ? topsoilVolume : sandVolume;
        const r = fn({
          length: v.length,
          width: v.width,
          depthInches,
          lengthUnit: lengthUnit(u),
          widthUnit: lengthUnit(u),
          wasteFactor: v.waste / 100,
          convertTons: v.convertTons > 0 ? v.convertTons : undefined,
          pricePerYard: v.pricePerYard > 0 ? v.pricePerYard : undefined,
          pricePerTon: v.pricePerTon > 0 ? v.pricePerTon : undefined,
          pricePerBag: v.pricePerBag > 0 ? v.pricePerBag : undefined,
        });
        return bulkResultRows(r);
      },
    };
  }

  function resultRows(r: {
    volumeCuFt: number;
    volumeCuYd: number;
    volumeCuM: number;
    bags40: number;
    bags50: number;
    bags60: number;
    bags80: number;
  }): [string, string][] {
    return [
      ['Volume', `${r.volumeCuFt} cu ft`],
      ['Cubic yards', String(r.volumeCuYd)],
      ['Cubic meters', String(r.volumeCuM)],
      ['40 lb bags', String(r.bags40)],
      ['50 lb bags', String(r.bags50)],
      ['60 lb bags', String(r.bags60)],
      ['80 lb bags', String(r.bags80)],
    ];
  }

  const configs: Record<string, CalculatorConfig> = {
    concrete: {
      fields: [
        {
          name: 'shape',
          label: 'Shape',
          type: 'select',
          options: [
            { value: 'slab', label: 'Slab / pad' },
            { value: 'footing', label: 'Footing' },
            { value: 'steps', label: 'Steps' },
          ],
          imperialDefault: 'slab',
          metricDefault: 'slab',
        },
        {
          name: 'length',
          label: 'Length',
          imperialDefault: '10',
          metricDefault: '3',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        {
          name: 'width',
          label: 'Width',
          imperialDefault: '10',
          metricDefault: '3',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        {
          name: 'thickness',
          label: 'Thickness / height',
          imperialDefault: '4',
          metricDefault: '10',
          imperialHint: 'inches for slabs',
          metricHint: 'centimeters',
        },
        { name: 'steps', label: 'Number of steps', imperialDefault: '3', metricDefault: '3' },
        {
          name: 'riser',
          label: 'Riser',
          imperialDefault: '7',
          metricDefault: '18',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        {
          name: 'tread',
          label: 'Tread',
          imperialDefault: '11',
          metricDefault: '28',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        { name: 'waste', label: 'Waste %', imperialDefault: '10', metricDefault: '10' },
        {
          name: 'priceBag40',
          label: 'Price per 40 lb bag (optional)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'your local price',
          metricHint: 'your local price',
        },
        {
          name: 'priceBag60',
          label: 'Price per 60 lb bag (optional)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'your local price',
          metricHint: 'your local price',
        },
        {
          name: 'priceBag80',
          label: 'Price per 80 lb bag (optional)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'your local price',
          metricHint: 'your local price',
        },
        {
          name: 'priceYd',
          label: 'Ready-mix price per cu yd (optional)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'your quote',
          metricHint: 'your quote',
        },
        {
          name: 'delivery',
          label: 'Delivery fee (optional)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'one-time fee',
          metricHint: 'one-time fee',
        },
      ],
      compute(v, u) {
        const waste = v.waste / 100;
        const shape = String((v as any).shapeRaw ?? 'slab');
        let r;
        if (shape === 'steps') {
          r = stepsVolume({
            numberOfSteps: v.steps,
            riser: v.riser,
            tread: v.tread,
            width: v.width,
            riserUnit: smallLengthUnit(u),
            treadUnit: smallLengthUnit(u),
            widthUnit: lengthUnit(u),
            wasteFactor: waste,
          });
        } else {
          r = slabVolume({
            length: v.length,
            width: v.width,
            thickness: v.thickness,
            lengthUnit: lengthUnit(u),
            widthUnit: lengthUnit(u),
            thicknessUnit: smallLengthUnit(u),
            wasteFactor: waste,
          });
        }
        const rows = resultRows(r);
        const cost = concreteCostCompare({
          volumeCuYd: r.volumeCuYd,
          bags40: r.bags40,
          bags60: r.bags60,
          bags80: r.bags80,
          pricePerBag40: v.priceBag40,
          pricePerBag60: v.priceBag60,
          pricePerBag80: v.priceBag80,
          pricePerCuYd: v.priceYd,
          deliveryFee: v.delivery,
        });
        rows.push(['Yards to order (↑¼ yd)', String(cost.orderCuYdQuarter)]);
        if (cost.bagCost40 != null) rows.push(['Bag cost (40 lb)', `$${cost.bagCost40}`]);
        if (cost.bagCost60 != null) rows.push(['Bag cost (60 lb)', `$${cost.bagCost60}`]);
        if (cost.bagCost80 != null) rows.push(['Bag cost (80 lb)', `$${cost.bagCost80}`]);
        if (cost.readyMixCost != null) rows.push(['Ready-mix + delivery', `$${cost.readyMixCost}`]);
        if (cost.readyMixCheaperThanBags != null) {
          rows.push([
            'Cheaper option',
            cost.readyMixCheaperThanBags ? 'Ready-mix (at your prices)' : 'Bags (at your prices)',
          ]);
        }
        return rows;
      },
    },
    'post-holes': {
      fields: [
        {
          name: 'diameter',
          label: 'Hole diameter',
          imperialDefault: '10',
          metricDefault: '25',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        {
          name: 'depth',
          label: 'Hole depth',
          imperialDefault: '2.5',
          metricDefault: '0.75',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        { name: 'count', label: 'Number of posts', imperialDefault: '8', metricDefault: '8' },
        { name: 'waste', label: 'Waste %', imperialDefault: '10', metricDefault: '10' },
      ],
      compute(v, u) {
        return resultRows(
          postHoleVolume({
            diameter: v.diameter,
            depth: v.depth,
            count: v.count,
            diameterUnit: smallLengthUnit(u),
            depthUnit: lengthUnit(u),
            wasteFactor: v.waste / 100,
          }),
        );
      },
    },
    sonotube: {
      fields: [
        {
          name: 'diameter',
          label: 'Tube diameter (size A)',
          imperialDefault: '12',
          metricDefault: '30',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        {
          name: 'height',
          label: 'Height (size A)',
          imperialDefault: '4',
          metricDefault: '1.2',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        { name: 'count', label: 'Number of tubes (size A)', imperialDefault: '4', metricDefault: '4' },
        {
          name: 'diameterB',
          label: 'Tube diameter (size B, optional)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'inches — 0 to skip',
          metricHint: 'cm — 0 to skip',
        },
        {
          name: 'heightB',
          label: 'Height (size B)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        { name: 'countB', label: 'Number of tubes (size B)', imperialDefault: '0', metricDefault: '0' },
        {
          name: 'baseType',
          label: 'Base under tube',
          type: 'select',
          options: [
            { value: 'none', label: 'None (tube only)' },
            { value: 'bell', label: 'Bell / flared base' },
            { value: 'pad', label: 'Circular pad' },
          ],
          imperialDefault: 'none',
          metricDefault: 'none',
        },
        {
          name: 'bellDiameter',
          label: 'Bell base diameter',
          imperialDefault: '24',
          metricDefault: '60',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        {
          name: 'bellHeight',
          label: 'Bell height',
          imperialDefault: '1',
          metricDefault: '0.3',
          imperialHint: 'feet',
          metricHint: 'meters',
        },
        {
          name: 'padDiameter',
          label: 'Pad diameter',
          imperialDefault: '24',
          metricDefault: '60',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        {
          name: 'padThickness',
          label: 'Pad thickness',
          imperialDefault: '12',
          metricDefault: '30',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        { name: 'waste', label: 'Waste %', imperialDefault: '5', metricDefault: '5' },
      ],
      compute(v, u) {
        const selects = (v as any).selectValues as Record<string, string> | undefined;
        const baseType = (selects?.baseType ?? 'none') as 'none' | 'bell' | 'pad';
        const groups = [
          {
            diameter: v.diameter,
            height: v.height,
            count: v.count,
            diameterUnit: smallLengthUnit(u) as any,
            heightUnit: lengthUnit(u) as any,
            baseType,
            bellDiameter: v.bellDiameter,
            bellHeight: v.bellHeight,
            padDiameter: v.padDiameter,
            padThickness: v.padThickness,
          },
        ];
        if (v.countB > 0 && v.diameterB > 0 && v.heightB > 0) {
          groups.push({
            diameter: v.diameterB,
            height: v.heightB,
            count: v.countB,
            diameterUnit: smallLengthUnit(u) as any,
            heightUnit: lengthUnit(u) as any,
            baseType,
            bellDiameter: v.bellDiameter,
            bellHeight: v.bellHeight,
            padDiameter: v.padDiameter,
            padThickness: v.padThickness,
          });
        }
        const r = mixedSonotubeVolume(groups, v.waste / 100);
        return [
          ['Volume', `${r.volumeCuFt} cu ft`],
          ['Cubic yards', String(r.volumeCuYd)],
          ['Cubic meters', String(r.volumeCuM)],
          ['40 lb bags', String(r.bags40)],
          ['50 lb bags', String(r.bags50)],
          ['60 lb bags', String(r.bags60)],
          ['80 lb bags', String(r.bags80)],
        ];
      },
    },
    'deck-footings': {
      fields: [
        {
          name: 'length',
          label: 'Deck length',
          imperialDefault: '16',
          metricDefault: '4.9',
          imperialHint: 'feet (along beams)',
          metricHint: 'meters (along beams)',
        },
        {
          name: 'width',
          label: 'Deck width',
          imperialDefault: '12',
          metricDefault: '3.7',
          imperialHint: 'feet (beam span direction)',
          metricHint: 'meters (beam span direction)',
        },
        {
          name: 'postSpacing',
          label: 'Post spacing',
          imperialDefault: '8',
          metricDefault: '2.4',
          imperialHint: 'feet along each beam',
          metricHint: 'meters along each beam',
        },
        {
          name: 'beamSpacing',
          label: 'Beam / post-row spacing',
          imperialDefault: '8',
          metricDefault: '2.4',
          imperialHint: 'feet across the deck',
          metricHint: 'meters across the deck',
        },
        {
          name: 'layout',
          label: 'Layout',
          type: 'select',
          options: [
            { value: 'freestanding', label: 'Freestanding (posts on all sides)' },
            { value: 'attached', label: 'Attached (ledger — no house-side posts)' },
          ],
          imperialDefault: 'freestanding',
          metricDefault: 'freestanding',
        },
        {
          name: 'frostDepth',
          label: 'Frost depth / hole depth',
          imperialDefault: '4',
          metricDefault: '1.2',
          imperialHint: 'feet (your local frost line)',
          metricHint: 'meters (your local frost line)',
        },
        {
          name: 'holeDiameter',
          label: 'Hole diameter',
          imperialDefault: '12',
          metricDefault: '30',
          imperialHint: 'inches',
          metricHint: 'cm',
        },
        {
          name: 'sonotubeDiameter',
          label: 'Sonotube diameter (optional)',
          imperialDefault: '0',
          metricDefault: '0',
          imperialHint: 'inches inside Ø; 0 = use hole diameter',
          metricHint: 'cm inside Ø; 0 = use hole diameter',
        },
        { name: 'waste', label: 'Waste %', imperialDefault: '5', metricDefault: '5' },
      ],
      compute(v, u) {
        const selects = (v as any).selectValues as Record<string, string> | undefined;
        const layout =
          (selects?.layout ?? (v as any).shapeRaw) === 'attached' ? 'attached' : 'freestanding';
        const r = deckFootings({
          length: v.length,
          width: v.width,
          postSpacing: v.postSpacing,
          beamSpacing: v.beamSpacing,
          frostDepth: v.frostDepth,
          holeDiameter: v.holeDiameter,
          sonotubeDiameter: v.sonotubeDiameter > 0 ? v.sonotubeDiameter : undefined,
          layout,
          lengthUnit: lengthUnit(u),
          widthUnit: lengthUnit(u),
          postSpacingUnit: lengthUnit(u),
          beamSpacingUnit: lengthUnit(u),
          frostDepthUnit: lengthUnit(u),
          holeDiameterUnit: smallLengthUnit(u),
          sonotubeDiameterUnit: smallLengthUnit(u),
          wasteFactor: v.waste / 100,
        });
        const sonoLabel =
          r.sonotubeDiameterIn != null
            ? `${r.sonotubeDiameterIn} in ID`
            : `${r.formDiameterIn} in (match hole)`;
        return [
          ['Footings (posts)', String(r.footingCount)],
          ['Posts along length', String(r.postsAlong)],
          ['Beam / post rows', String(r.beamRows)],
          ['Hole diameter', `${r.holeDiameterIn} in`],
          ['Hole depth (frost)', `${r.holeDepthFt} ft`],
          ['Sonotube / form Ø', sonoLabel],
          ['Concrete per hole', `${r.volumePerHoleCuFt} cu ft (${r.volumePerHoleCuYd} cu yd)`],
          [
            'Total concrete',
            `${r.totalVolumeCuFt} cu ft (${r.totalVolumeCuYd} cu yd / ${r.totalVolumeCuM} m³)`,
          ],
          ['40 lb bags', String(r.bags40)],
          ['60 lb bags', String(r.bags60)],
          ['80 lb bags', String(r.bags80)],
        ];
      },
    },
    footing: {
      fields: [
        {
          name: 'footingType',
          label: 'Footing type',
          type: 'select',
          options: [
