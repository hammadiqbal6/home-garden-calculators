  function init(root: HTMLElement) {
    const id = root.dataset.calculator || '';
    const config = configs[id];
    if (!config) return;

    const fieldsEl = root.querySelector('.calc-fields') as HTMLElement;
    const resultsEl = root.querySelector('.results') as HTMLElement;
    const dl = root.querySelector('.results-dl') as HTMLElement;
    const err = root.querySelector('.calc-error') as HTMLElement;
    let units: Units = 'imperial';
    let skipTrack = true;
    const params = new URLSearchParams(window.location.search);
    if (params.get('units') === 'metric') units = 'metric';

    function bindInputs() {
      root.querySelectorAll('input,select').forEach((el) => {
        el.addEventListener('input', calculate);
        el.addEventListener('change', () => {
          toggleModeFields();
          calculate();
        });
      });
    }

    function renderFields() {
      // Rebuild only when switching unit systems so SSR layout stays stable on first paint.
      const grid = document.createElement('div');
      grid.className = 'field-grid cols-2';
      for (const field of config.fields) {
        const wrap = document.createElement('div');
        wrap.className = 'field';
        wrap.dataset.field = field.name;
        const label = document.createElement('label');
        label.htmlFor = `${id}-${field.name}`;
        label.textContent = field.label;
        wrap.appendChild(label);
        let input: HTMLInputElement | HTMLSelectElement;
        if (field.type === 'select' && field.options) {
          input = document.createElement('select');
          for (const opt of field.options) {
            const o = document.createElement('option');
            o.value = opt.value;
            o.textContent = opt.label;
            input.appendChild(o);
          }
        } else {
          input = document.createElement('input');
          input.type = 'number';
          input.inputMode = 'decimal';
          input.step = field.step || 'any';
          input.min = field.min || '0';
          input.required = !field.optional;
        }
        input.id = `${id}-${field.name}`;
        input.name = field.name;
        const fromQuery = params.get(field.name);
        input.value =
          fromQuery ?? (units === 'imperial' ? field.imperialDefault : field.metricDefault);
        wrap.appendChild(input);
        const hint = document.createElement('p');
        hint.className = 'hint';
        hint.textContent = (units === 'imperial' ? field.imperialHint : field.metricHint) || '';
        if (hint.textContent) wrap.appendChild(hint);
        grid.appendChild(wrap);
      }
      fieldsEl.replaceChildren(grid);
      toggleModeFields();
      bindInputs();
    }

    function toggleModeFields() {
      if (id === 'sonotube') {
        const baseType = root.querySelector<HTMLSelectElement>('[name="baseType"]')?.value ?? 'none';
        for (const name of ['bellDiameter', 'bellHeight']) {
          const el = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
          if (el) el.hidden = baseType !== 'bell';
        }
        for (const name of ['padDiameter', 'padThickness']) {
          const el = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
          if (el) el.hidden = baseType !== 'pad';
        }
        return;
      }
      if (id === 'concrete') {
        const shape = root.querySelector<HTMLSelectElement>('[name="shape"]')?.value;
        for (const name of ['steps', 'riser', 'tread']) {
          const el = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
          if (el) el.hidden = shape !== 'steps';
        }
        for (const name of ['thickness']) {
          const el = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
          if (el) el.hidden = shape === 'steps';
        }
        const lengthLabel = root.querySelector<HTMLElement>('[data-field="length"] label');
        if (lengthLabel) lengthLabel.textContent = shape === 'steps' ? 'Stair width' : 'Length';
        return;
      }
      if (id === 'footing') {
        const rebarOn =
          root.querySelector<HTMLSelectElement>('[name="rebar"]')?.value === 'yes';
        const footingType =
          root.querySelector<HTMLSelectElement>('[name="footingType"]')?.value ?? 'strip';
        for (const name of ['spacing', 'barSize', 'stick', 'rebarWaste']) {
          const el = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
          if (el) el.hidden = !rebarOn;
        }
        const longEl = root.querySelector<HTMLElement>('[data-field="longBars"]');
        if (longEl) longEl.hidden = !rebarOn || footingType !== 'strip';
        const countLabel = root.querySelector<HTMLElement>('[data-field="count"] label');
        if (countLabel) {
          countLabel.textContent = footingType === 'pad' ? 'Number of pads' : 'Number of segments';
        }
        return;
      }
      if (id === 'lumber') {
        const mode = root.querySelector<HTMLSelectElement>('[name="mode"]')?.value ?? 'pieces';
        const piecesEl = root.querySelector<HTMLElement>('[data-field="pieces"]');
        const bfEl = root.querySelector<HTMLElement>('[data-field="boardFeet"]');
        if (piecesEl) piecesEl.hidden = mode !== 'pieces';
        if (bfEl) bfEl.hidden = mode !== 'boardFeet';
        const species =
          root.querySelector<HTMLSelectElement>('[name="species"]')?.value ?? 'spf_kd';
        const densityEl = root.querySelector<HTMLElement>('[data-field="density"]');
        if (densityEl) densityEl.hidden = species !== 'custom';
        return;
      }
      if (id === 'concrete-slab-cost') {
        const mode =
          root.querySelector<HTMLSelectElement>('[name="purchaseMode"]')?.value ?? 'ready-mix';
        const ready = mode === 'ready-mix';
        for (const name of ['readyMixPrice']) {
          const el = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
          if (el) el.hidden = !ready;
        }
        for (const name of ['bagSize', 'bagPrice']) {
          const el = root.querySelector<HTMLElement>(`[data-field="${name}"]`);
          if (el) el.hidden = ready;
        }
        return;
      }
      if (id === 'brick') {
        const mode = root.querySelector<HTMLSelectElement>('[name="mode"]')?.value ?? 'brick';
        const unitL = root.querySelector<HTMLInputElement>('[name="unitL"]');
        const unitH = root.querySelector<HTMLInputElement>('[name="unitH"]');
        if (!unitL || !unitH) return;
        // Apply modular presets when switching type (imperial defaults).
        if (units === 'imperial') {
          if (mode === 'cmu') {
            if (unitL.value === '7.625' || unitL.dataset.preset === 'brick') {
              unitL.value = '15.625';
              unitH.value = '7.625';
              unitL.dataset.preset = 'cmu';
              unitH.dataset.preset = 'cmu';
            }
          } else if (unitL.value === '15.625' || unitL.dataset.preset === 'cmu') {
            unitL.value = '7.625';
            unitH.value = '2.25';
            unitL.dataset.preset = 'brick';
            unitH.dataset.preset = 'brick';
          }
        }
      }
    }

    function readValues() {
      const values: Record<string, number> = {};
      const selectValues: Record<string, string> = {};
      root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input,select').forEach((el) => {
        if (el instanceof HTMLSelectElement) {
          selectValues[el.name] = el.value;
          return;
        }
        values[el.name] = Number(el.value);
      });
      (values as any).selectValues = selectValues;
      // Backward-compatible alias used by the concrete shape branch.
      (values as any).shapeRaw =
        selectValues.shape ??
        selectValues.footingType ??
        selectValues.mode ??
        selectValues.barSize ??
        selectValues.layout ??
        'slab';
      return values;
    }

    function clearFieldErrors() {
      root.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((el) => {
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      });
      err.hidden = true;
      err.textContent = '';
    }

    function markInvalidFields(message: string) {
      const allowZero = new Set([
        'waste',
        'sonotubeDiameter',
        'rebarWaste',
        'doors',
        'windows',
        'rise',
        'trunk',
        'doorWidth',
        'doorHeight',
        'windowWidth',
        'windowHeight',
        'joint',
        'diameterB',
        'heightB',
        'countB',
        'bellDiameter',
        'bellHeight',
        'padDiameter',
        'padThickness',
        'priceBag40',
        'priceBag60',
        'priceBag80',
        'priceYd',
        'delivery',
        'convertTons',
        'pricePerYard',
        'pricePerTon',
        'pricePerBag',
        'readyMixPrice',
        'bagPrice',
        'gravelBase',
        'rebarMesh',
        'forms',
        'delivery',
        'labor',
      ]);
      const inputs = [
        ...root.querySelectorAll<HTMLInputElement>('input[type="number"]'),
      ].filter((el) => {
        const wrap = el.closest<HTMLElement>('[data-field]');
        return !wrap?.hidden;
      });
      let marked = false;
      for (const el of inputs) {
        const raw = el.value.trim();
        const optionalEmpty = allowZero.has(el.name) && raw === '';
        if (optionalEmpty) continue;
        const v = Number(el.value);
        const zeroOk = allowZero.has(el.name);
        const bad = !Number.isFinite(v) || v < 0 || (!zeroOk && v <= 0);
        if (bad) {
          el.setAttribute('aria-invalid', 'true');
          el.setAttribute('aria-describedby', err.id || `${id}-calc-error`);
          marked = true;
        }
      }
      if (!marked && inputs[0]) {
        inputs[0].setAttribute('aria-invalid', 'true');
        inputs[0].setAttribute('aria-describedby', err.id || `${id}-calc-error`);
      }
      err.hidden = false;
      err.textContent = message;
    }

    function calculate() {
      clearFieldErrors();
      try {
        const values = readValues();
        const rows = config.compute(values, units);
        dl.innerHTML = rows.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('');
        resultsEl.hidden = false;
        syncQuery(values);
        if (!skipTrack) {
          track('calculation_run', {
            calculator_id: calculatorId,
            unit_system: units,
          });
        }
      } catch (e) {
        markInvalidFields(e instanceof Error ? e.message : 'Check your inputs.');
      }
    }

    function syncQuery(values: Record<string, number>) {
      if (root.dataset.embed === 'true') return;
      const sp = new URLSearchParams();
      sp.set('units', units);
      for (const [k, v] of Object.entries(values)) {
        if (k === 'shape' || k === 'shapeRaw' || k === 'selectValues') continue;
        if (Number.isFinite(v)) sp.set(k, String(v));
      }
      const selectValues = (values as any).selectValues as Record<string, string> | undefined;
      if (selectValues) {
        for (const [k, v] of Object.entries(selectValues)) {
          if (v) sp.set(k, v);
        }
      } else {
        const shapeRaw = (values as any).shapeRaw;
        if (shapeRaw) sp.set('shape', String(shapeRaw));
      }
      window.history.replaceState({}, '', `${window.location.pathname}?${sp.toString()}`);
    }

    root.querySelectorAll<HTMLButtonElement>('.unit-toggle button').forEach((btn) => {
      btn.addEventListener('click', () => {
        units = (btn.dataset.units as Units) || 'imperial';
        root.querySelectorAll<HTMLButtonElement>('.unit-toggle button').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === btn));
        });
        track('unit_toggle', {
          calculator_id: calculatorId,
          unit_system: units,
        });
        renderFields();
        calculate();
      });
    });

    root.querySelector('[data-action="copy"]')?.addEventListener('click', async () => {
      const text = Array.from(dl.querySelectorAll('dt'))
        .map((dt, i) => `${dt.textContent}: ${dl.querySelectorAll('dd')[i]?.textContent ?? ''}`)
        .join('\n');
      await navigator.clipboard?.writeText(text);
    });
    root.querySelector('[data-action="share"]')?.addEventListener('click', async () => {
      const shareUrl = window.location.href.split('#')[0];
      if (navigator.share) await navigator.share({ title: document.title, url: shareUrl });
      else await navigator.clipboard?.writeText(shareUrl);
    });
    root.querySelector('[data-action="print"]')?.addEventListener('click', () => window.print());

    // Apply query/unit overrides without wiping SSR markup when already imperial defaults.
    if (units === 'metric' || [...params.keys()].some((k) => k !== 'units')) {
      renderFields();
    } else {
      toggleModeFields();
      bindInputs();
    }
    // Sync unit toggle pressed state
    root.querySelectorAll<HTMLButtonElement>('.unit-toggle button').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.units === units));
    });
    calculate();
    skipTrack = false;
  }

  function track(name: string, params: Record<string, string> = {}) {
    try {
      const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      if (typeof gtag === 'function') gtag('event', name, params);
    } catch {
      /* analytics optional */
    }
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('.calc-root').forEach(init);
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
