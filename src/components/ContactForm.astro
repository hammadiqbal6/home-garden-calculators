---
interface Props {
  serviceId: string;
  templateId: string;
  publicKey: string;
  siteName: string;
  contactEmail: string;
}

const { serviceId, templateId, publicKey, siteName, contactEmail } = Astro.props;
---

<form
  id="contact-form"
  class="contact-form"
  method="post"
  action="#"
  onsubmit="return false;"
  data-service-id={serviceId}
  data-template-id={templateId}
  data-public-key={publicKey}
  data-site-name={siteName}
>
  <div class="field">
    <label for="contact-name">Name</label>
    <input
      id="contact-name"
      name="from_name"
      type="text"
      autocomplete="name"
      required
      maxlength="120"
      minlength="1"
    />
  </div>
  <div class="field">
    <label for="contact-email">Email</label>
    <input
      id="contact-email"
      name="reply_to"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      maxlength="200"
    />
  </div>
  <div class="field">
    <label for="contact-message">Message</label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="6"
      maxlength="3000"
      minlength="10"
    />
    <p class="hint">Max 3,000 characters. Include the calculator URL if reporting a bug.</p>
  </div>
  {/* Honeypot — leave empty. Hidden from assistive tech / tab order. */}
  <div class="hp-field" aria-hidden="true">
    <label for="contact-company">Company</label>
    <input
      id="contact-company"
      name="company"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <p id="contact-form-status" class="form-status" role="status" aria-live="polite" hidden></p>
  <div class="btn-row">
    <button type="submit" class="btn btn-primary">Send message</button>
  </div>
</form>

<p class="contact-mailto-secondary">
  Prefer email? <a href={`mailto:${contactEmail}`}>Write to {contactEmail}</a> (works without
  JavaScript).
</p>

<script>
  import '../scripts/contact-form';
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0 var(--space-4);
    max-width: 36rem;
  }
  .contact-form .field {
    margin: 0;
  }
  .contact-form textarea {
    min-height: 9rem;
    resize: vertical;
  }
  .hp-field {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-status {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.95rem;
  }
  .form-status[data-tone='ok'] {
    color: var(--color-brand-dark);
  }
  .form-status[data-tone='err'] {
    color: #9b2c2c;
  }
  .contact-mailto-secondary {
    margin: var(--space-4) 0 var(--space-5);
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }
  .btn-row {
    margin: 0;
  }
  button.btn[disabled],
  button.btn[aria-busy='true'] {
    opacity: 0.65;
    cursor: not-allowed;
  }
</style>
