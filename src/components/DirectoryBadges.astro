---
/**
 * Footer directory-listing badges (Fazier, TinyLaunch, BetaList, …).
 * Data comes from siteConfig.directoryBadges (PUBLIC_DIRECTORY_BADGES JSON, or
 * the Fazier fallback). Links are followable unless a badge sets `rel`.
 */
import { siteConfig } from '../config/site';

const badges = siteConfig.directoryBadges;
---

{
  badges.length > 0 && (
    <div class="directory-badges" aria-label="Directory listings">
      {
        badges.map((badge) => (
          <a
            class="directory-badge"
            href={badge.href}
            target="_blank"
            rel={badge.rel || undefined}
          >
            {
              badge.imgDark ? (
                <picture>
                  <source media="(prefers-color-scheme: dark)" srcset={badge.imgDark} />
                  <img
                    src={badge.img}
                    width={badge.width}
                    height={badge.height}
                    alt={badge.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              ) : (
                <img
                  src={badge.img}
                  width={badge.width}
                  height={badge.height}
                  alt={badge.alt}
                  loading="lazy"
                  decoding="async"
                />
              )
            }
          </a>
        ))
      }
    </div>
  )
}
