---
import { siteConfig } from '../config/site';
import type { ToolSource } from '../data/tools';

interface Props {
  sources: ToolSource[];
  lastReviewed: string;
  calculatorVersion?: string;
  disclaimer?: string;
}

const {
  sources,
  lastReviewed,
  calculatorVersion = '1.0',
  disclaimer = 'Estimates only—confirm bag yields on the product label and check local building codes before you pour or order. Not affiliated with QUIKRETE, Sakrete, Sonoco, or any manufacturer named in the sources.',
} = Astro.props;

function formatDate(iso: string): string {
  const d = new Date(`${iso}T12:00:00Z`);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<section class="trust" id="sources" aria-labelledby="sources-h">
  <p class="byline">
    Built and maintained by
    <a href={siteConfig.author.urlPath} rel="author">{siteConfig.author.name}</a>
    · Last reviewed <time datetime={lastReviewed}>{formatDate(lastReviewed)}</time>
    · <a href="/methodology/">How this tool works</a>
  </p>

  <h2 id="sources-h">Sources</h2>
  <ol class="refs">
    {
      sources.map((s) => (
        <li>
          <a href={s.href} rel="noopener noreferrer">
            {s.label}
          </a>
          {s.usedFor ? <> Used for: {s.usedFor}.</> : null}
          {' '}
          Checked <time datetime={s.checked || lastReviewed}>{s.checked || lastReviewed}</time>.
        </li>
      ))
    }
  </ol>

  <p class="disclaimer">
    {disclaimer}
    Found an error? <a href="/contact/">Tell me</a>.
  </p>
  <p class="version">
    Calculator version {calculatorVersion} ·
    <a href="/methodology/#changelog">Changelog</a>
  </p>
</section>
