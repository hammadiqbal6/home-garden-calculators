---
import DirectoryBadges from '../components/DirectoryBadges.astro';
import { siteConfig } from '../config/site';
import { GDPR_CONSENT_REGION_CODES } from '../lib/gdprRegions';
import { formatPageTitle } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Omit on error pages so soft-404s do not canonicalize to a crawlable /404/. */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
  ogImagePath?: string;
  ogImageAlt?: string;
}

const {
  title: titleProp,
  description,
  canonicalPath,
  ogType = 'website',
  jsonLd = [],
  noIndex = false,
  ogImagePath = siteConfig.defaultOgImage,
  ogImageAlt = siteConfig.defaultOgImageAlt,
} = Astro.props;

/** Single brand suffix — strips a trailing `| {brand}` then re-adds it once. */
const title = formatPageTitle(titleProp);

const canonical = canonicalPath
  ? new URL(
      canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`,
      siteConfig.siteUrl.endsWith('/') ? siteConfig.siteUrl : `${siteConfig.siteUrl}/`,
    ).toString()
  : undefined;

const ogImage = new URL(ogImagePath, siteConfig.siteUrl).toString();
const ogImageType = /\.jpe?g$/i.test(ogImagePath)
  ? 'image/jpeg'
  : /\.webp$/i.test(ogImagePath)
    ? 'image/webp'
    : /\.svg$/i.test(ogImagePath)
      ? 'image/svg+xml'
      : 'image/png';
const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const gaId = siteConfig.analytics.ga4MeasurementId;
const gsc = siteConfig.analytics.searchConsoleVerification;
const bing = siteConfig.analytics.bingVerification;
const brand = siteConfig.brandColor;
/** EEA + UK + CH — Consent Mode region defaults + site banner suppression. */
const gdprRegions = [...GDPR_CONSENT_REGION_CODES];
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(siteConfig.defaultOgImageWidth)} />
    <meta property="og:image:height" content={String(siteConfig.defaultOgImageHeight)} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- Favicon / PWA set (Google favicon guidance: ICO + PNG ≥48px; SVG optional) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.shortName} />
    <meta name="theme-color" content={brand} />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    {bing && <meta name="msvalidate.01" content={bing} />}
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    {
      /* Consent Mode defaults must run before adsbygoogle / gtag.js. */
      (gaId ||
        (siteConfig.adsense.enabled &&
          siteConfig.adsense.publisherId.startsWith('ca-pub-') &&
          !siteConfig.adsense.publisherId.includes('XXXX'))) && (
        <script is:inline define:vars={{ gaId, gdprRegions }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = window.gtag || gtag;

          function __ytIsCmpRegion() {
            if (window.__ytCmpRegion) return true;
            var meta = document.querySelector('meta[name="yt-geo-country"]');
            var cc = meta ? String(meta.getAttribute('content') || '').toUpperCase() : '';
            if (cc && gdprRegions.indexOf(cc) !== -1) {
              window.__ytCmpRegion = true;
              return true;
            }
            return false;
          }
          window.__ytIsCmpRegion = __ytIsCmpRegion;
          __ytIsCmpRegion();

          // Consent Mode v2 — EEA/UK/CH: denied until Google's certified CMP updates.
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 2000,
            region: gdprRegions,
          });
          // Everywhere else: denied until the site cookie notice is accepted (unchanged).
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500,
          });

          if (gaId) {
            gtag('js', new Date());
            gtag('config', gaId, {
              anonymize_ip: true,
              send_page_view: true,
            });

            window.__ycLoadGa = function () {
              if (window.__ycGaLoaded) return;
              window.__ycGaLoaded = true;
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
              document.head.appendChild(s);
            };

            window.__ycGrantConsent = function () {
              // Site banner grant — not used in Google CMP regions.
              if (__ytIsCmpRegion()) return;
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted',
              });
              window.__ycLoadGa();
            };

            // Defer GA script until idle, first interaction, or prior non-CMP consent.
            function scheduleGa() {
              try {
                if (__ytIsCmpRegion()) {
                  // Advanced Consent Mode: load the tag; Google's CMP updates consent.
                } else if (localStorage.getItem('yc_cookie_ok') === '1') {
                  window.__ycGrantConsent();
                  return;
                }
              } catch (e) {}
              var armed = false;
              function arm() {
                if (armed) return;
                armed = true;
                if ('requestIdleCallback' in window) {
                  requestIdleCallback(
                    function () {
                      window.__ycLoadGa();
                    },
                    { timeout: 4000 },
                  );
                } else {
                  setTimeout(window.__ycLoadGa, 3500);
                }
              }
              ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (evt) {
                window.addEventListener(evt, arm, { once: true, passive: true });
              });
              setTimeout(arm, 6000);
            }
            scheduleGa();
          }
        </script>
      )
    }
    {
      siteConfig.adsense.enabled &&
        siteConfig.adsense.publisherId.startsWith('ca-pub-') &&
        !siteConfig.adsense.publisherId.includes('XXXX') && (
          <script
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsense.publisherId}`}
            crossorigin="anonymous"
          />
        )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">Y</span>
          <span>{siteConfig.name}</span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          Menu
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <a href="/calculators/">Calculators</a>
          <a href="/hubs/concrete/">Concrete</a>
          <a href="/hubs/landscape/">Landscape</a>
          <a href="/hubs/outdoor-structures/">Outdoor</a>
          <a href="/hubs/lawn/">Lawn</a>
          <a href="/guides/">Guides</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">Y</span>
            <span>{siteConfig.name}</span>
          </a>
          <p>{siteConfig.tagline}. All math runs in your browser—nothing is uploaded.</p>
        </div>
        <div>
          <p class="footer-heading">Tools</p>
          <ul>
            <li><a href="/hubs/concrete/">Concrete hub</a></li>
            <li><a href="/hubs/landscape/">Landscape hub</a></li>
            <li><a href="/hubs/outdoor-structures/">Outdoor hub</a></li>
            <li><a href="/hubs/lawn/">Lawn hub</a></li>
            <li><a href="/calculators/">All calculators</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-heading">Guides</p>
          <ul>
            <li><a href="/guides/how-many-bags-of-concrete/">Concrete bags</a></li>
            <li><a href="/guides/mulch-depth-guide/">Mulch depth</a></li>
            <li><a href="/guides/how-to-measure-roof-pitch/">Roof pitch</a></li>
            <li><a href="/guides/">All guides</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-heading">Trust</p>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/methodology/">Methodology</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <p class="footer-copy">
          © {new Date().getFullYear()} {siteConfig.copyrightOwner}. Maintained by {siteConfig.author.name}.
          Estimates only—verify with manufacturers and local codes.
        </p>
        <DirectoryBadges />
      </div>
    </footer>
    <div class="cookie-notice" id="cookie-notice" role="dialog" aria-label="Cookie notice" hidden>
      <p>
        Cookies for analytics{siteConfig.adsense.enabled ? ' and ads' : ''}.
        <a href="/privacy/">Privacy</a>
      </p>
      <div class="cookie-actions">
        <button type="button" class="btn btn-secondary" id="cookie-reject">Reject</button>
        <button type="button" class="btn btn-primary" id="cookie-accept">Accept</button>
      </div>
    </div>
    <script is:inline define:vars={{ gdprRegions }}>
      (function () {
        var toggle = document.querySelector('.nav-toggle');
        var nav = document.getElementById('site-nav');
        function setNavOpen(open) {
          if (!toggle || !nav) return;
          nav.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        }
        if (toggle && nav) {
          toggle.addEventListener('click', function () {
            setNavOpen(!nav.classList.contains('open'));
          });
          document.addEventListener('keydown', function (ev) {
            if (ev.key !== 'Escape') return;
            if (!nav.classList.contains('open')) return;
            setNavOpen(false);
            toggle.focus();
          });
        }

        var notice = document.getElementById('cookie-notice');
        var accept = document.getElementById('cookie-accept');
        var reject = document.getElementById('cookie-reject');
        var gdprSet = {};
        for (var i = 0; i < gdprRegions.length; i++) gdprSet[gdprRegions[i]] = true;

        function dismissCookieNotice() {
          if (!notice) return;
          notice.classList.remove('show');
          notice.hidden = true;
          document.body.classList.remove('cookie-visible');
        }

        function readCfCountry() {
          var meta = document.querySelector('meta[name="yt-geo-country"]');
          return meta ? String(meta.getAttribute('content') || '').toUpperCase() : '';
        }

        function isGdprCountry(cc) {
          return !!(cc && gdprSet[cc]);
        }

        function isUnknownCountry(cc) {
          return !cc || cc === 'XX' || cc === 'T1';
        }

        /** Prefer Cloudflare country; also honor __tcfapi gdprApplies when present. */
        function enterCmpRegion() {
          window.__ytCmpRegion = true;
          dismissCookieNotice();
        }

        function showSiteBannerIfNeeded() {
          try {
            if (window.__ytCmpRegion) return;
            if (!notice || localStorage.getItem('yc_cookie_ok') != null) return;
            notice.hidden = false;
            notice.classList.add('show');
            document.body.classList.add('cookie-visible');
          } catch (e) {}
        }

        function pingTcf(cb) {
          var tries = 0;
          function attempt() {
            if (typeof window.__tcfapi === 'function') {
              try {
                window.__tcfapi('ping', 2, function (data) {
                  cb(!!(data && data.gdprApplies));
                });
                return;
              } catch (e) {
                cb(false);
                return;
              }
            }
            if (++tries < 20) setTimeout(attempt, 100);
            else cb(false);
          }
          attempt();
        }

        function decideBanner() {
          var cc = readCfCountry();
          if (isGdprCountry(cc)) {
            enterCmpRegion();
            return;
          }
          // Known non-GDPR country: keep the existing site banner behaviour.
          if (!isUnknownCountry(cc)) {
            showSiteBannerIfNeeded();
            // Still watch TCF in case geo and CMP disagree (rare).
            pingTcf(function (applies) {
              if (applies) enterCmpRegion();
            });
            return;
          }
          // Unknown / Tor: wait briefly for Funding Choices TCF before showing ours.
          pingTcf(function (applies) {
            if (applies) enterCmpRegion();
            else showSiteBannerIfNeeded();
          });
        }

        try {
          decideBanner();
          accept &&
            accept.addEventListener('click', function () {
              if (window.__ytCmpRegion) {
                dismissCookieNotice();
                return;
              }
              localStorage.setItem('yc_cookie_ok', '1');
              dismissCookieNotice();
              if (typeof window.__ycGrantConsent === 'function') window.__ycGrantConsent();
            });
          reject &&
            reject.addEventListener('click', function () {
              if (window.__ytCmpRegion) {
                dismissCookieNotice();
                return;
              }
              localStorage.setItem('yc_cookie_ok', '0');
              dismissCookieNotice();
            });
        } catch (e) {}

        // Track outbound reference clicks for GA4 (after consent / when gtag exists).
        document.addEventListener(
          'click',
          function (ev) {
            var t = ev.target;
            if (!t || !t.closest) return;
            var a = t.closest('a[href]');
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (!/^https?:\/\//i.test(href)) return;
            if (href.indexOf(location.hostname) !== -1) return;
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'outbound_reference_click', {
                link_url: href,
                link_text: (a.textContent || '').trim().slice(0, 100),
              });
            }
          },
          true,
        );
      })();
    </script>
  </body>
</html>
