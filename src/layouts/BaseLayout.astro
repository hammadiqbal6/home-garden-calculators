---
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  jsonLd = [],
  noIndex = false,
} = Astro.props;

const canonical = new URL(
  canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`,
  siteConfig.siteUrl.endsWith('/') ? siteConfig.siteUrl : `${siteConfig.siteUrl}/`,
).toString();

const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const gaId = siteConfig.analytics.ga4MeasurementId;
const gsc = siteConfig.analytics.searchConsoleVerification;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(siteConfig.defaultOgImage, siteConfig.siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1f6b4a" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    {
      siteConfig.adsense.enabled && siteConfig.adsense.publisherId.startsWith('ca-pub-') && !siteConfig.adsense.publisherId.includes('XXXX') && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsense.publisherId}`}
          crossorigin="anonymous"
        />
      )
    }
    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId, { anonymize_ip: true });
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">Y</span>
          <span>{siteConfig.name}</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <a href="/calculators/">Calculators</a>
          <a href="/hubs/concrete/">Concrete</a>
          <a href="/hubs/landscape/">Landscape</a>
          <a href="/guides/">Guides</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">Y</span>
            <span>{siteConfig.name}</span>
          </a>
          <p>{siteConfig.tagline}. All math runs in your browser—nothing is uploaded.</p>
        </div>
        <div>
          <h2>Tools</h2>
          <ul>
            <li><a href="/calculators/concrete-calculator/">Concrete</a></li>
            <li><a href="/calculators/mulch-calculator/">Mulch</a></li>
            <li><a href="/calculators/gravel-calculator/">Gravel</a></li>
            <li><a href="/calculators/">All calculators</a></li>
          </ul>
        </div>
        <div>
          <h2>Guides</h2>
          <ul>
            <li><a href="/guides/how-many-bags-of-concrete/">Concrete bags</a></li>
            <li><a href="/guides/mulch-depth-guide/">Mulch depth</a></li>
            <li><a href="/guides/how-to-measure-roof-pitch/">Roof pitch</a></li>
            <li><a href="/guides/">All guides</a></li>
          </ul>
        </div>
        <div>
          <h2>Trust</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/methodology/">Methodology</a></li>
            <li><a href="/authors/">Authors</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="container" style="margin-top:1.5rem;font-size:0.9rem;color:var(--color-ink-muted)">
        © {new Date().getFullYear()} {siteConfig.name}. Estimates only—verify with manufacturers and local codes.
      </div>
    </footer>
    <div class="cookie-notice" id="cookie-notice" role="dialog" aria-label="Cookie notice">
      <p>
        We may use cookies for analytics and—once enabled—ads. See our
        <a href="/privacy/">Privacy Policy</a>.
      </p>
      <button type="button" class="btn btn-primary" id="cookie-accept">OK</button>
    </div>
    <script is:inline>
      (function () {
        var toggle = document.querySelector('.nav-toggle');
        var nav = document.getElementById('site-nav');
        if (toggle && nav) {
          toggle.addEventListener('click', function () {
            var open = nav.classList.toggle('open');
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        var notice = document.getElementById('cookie-notice');
        var accept = document.getElementById('cookie-accept');
        try {
          if (notice && !localStorage.getItem('yc_cookie_ok')) notice.classList.add('show');
          accept &&
            accept.addEventListener('click', function () {
              localStorage.setItem('yc_cookie_ok', '1');
              notice.classList.remove('show');
            });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
