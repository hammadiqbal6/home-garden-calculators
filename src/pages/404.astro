---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | YardCalc Home & Garden Tools"
  description="That YardCalc page is missing or moved. Browse free concrete, mulch, gravel, fence, deck, and lawn calculators—or return home to start over."
  canonicalPath="/404/"
  noIndex={true}
>
  <div class="container" style="padding:3rem 0;text-align:center">
    <h1>Page not found</h1>
    <p class="answer-first">That URL is not in our calculator hub. Try one of these popular tools:</p>
    <div class="btn-row" style="justify-content:center">
      <a class="btn btn-primary" href="/calculators/">All calculators</a>
      <a class="btn btn-secondary" href="/calculators/concrete-calculator/">Concrete</a>
      <a class="btn btn-secondary" href="/calculators/mulch-calculator/">Mulch</a>
      <a class="btn btn-secondary" href="/guides/">Guides</a>
    </div>
  </div>
</BaseLayout>
