---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';
import { siblingSitesForAbout } from '../config/sisterSites';
import { absoluteUrl } from '../data/tools';
import { profilePageJsonLd, organizationNode, personNode } from '../lib/schema';

const jsonLd = [
  profilePageJsonLd(),
  {
    '@context': 'https://schema.org',
    '@graph': [organizationNode(), personNode()],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'About', item: absoluteUrl('/about/') },
    ],
  },
];
---

<BaseLayout
  title={`About ${siteConfig.name} — Free Home & Garden Calculators`}
  description={`${siteConfig.name} is a free home and garden calculator site built by ${siteConfig.author.name}. Honest methodology, cited sources, and private in-browser math.`}
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'About' }]} />
  <article class="container prose panel" style="margin:1rem auto 3rem;max-width:800px">
    <h1>About {siteConfig.name}</h1>
    <p class="answer-first">
      {siteConfig.name} is a free set of home and garden material calculators, built and maintained by one
      person: me, {siteConfig.author.name}.
    </p>

    <h2>Why I built it</h2>
    <p>
      When I planned patio, fence, and landscaping projects, I kept bouncing between manufacturer bag charts,
      extension articles, and half-finished online widgets that hid their formulas. I wanted one place that
      showed the math, cited the bag yields and depth guidance it used, and never uploaded my measurements.
      {siteConfig.name} is that toolkit: concrete, mulch, gravel, fencing, decking, roofing, paint, and lawn
      estimators that run entirely in your browser.
    </p>

    <h2 id="maintainer">Who I am</h2>
    <p>{siteConfig.author.bio}</p>
    <p>
      Find me on
      {
        siteConfig.author.sameAs.map((url, i) => (
          <>
            {i > 0 ? ', ' : ' '}
            <a href={url} rel="me noopener noreferrer">
              {url.replace(/^https?:\/\//, '')}
            </a>
          </>
        ))
      }.
    </p>

    <h2>How the tools are made</h2>
    <p>
      Every tool lists its formula and its sources at the bottom of the page. Sources are manufacturer
      coverage pages (for example QUIKRETE bag yields), American Cement Association materials, ACI residential
      concrete guidance, and university extension pages on mulch depth and lawn fertility. Each page shows the
      date I last checked it against those sources. Full details:
      <a href="/methodology/">Methodology</a>.
    </p>

    <h2>What this site doesn’t do</h2>
    <ul>
      <li>
        It doesn’t give engineering, structural, or building-code advice. Results are planning estimates—confirm
        thickness, frost depth, and reinforcement with local codes and a licensed professional when required.
      </li>
      <li>
        Your inputs stay in your browser. Analytics (GA4) load only after cookie consent, with Consent Mode v2
        defaults denied until then. Ads stay off until AdSense is explicitly enabled.
      </li>
      <li>
        It isn’t affiliated with QUIKRETE, Sakrete, Sonoco/Sonotube, or any brand named in the sources.
      </li>
    </ul>

    <h2>How the site is funded</h2>
    <p>
      {siteConfig.adsense.enabled
        ? 'The site may show Google AdSense ads once approved. There are no paid product placements in the calculators themselves.'
        : 'Right now the site is free to use with no ads enabled. If AdSense is approved later, that will be disclosed here and in the privacy policy.'}
    </p>

    <h2>Other free tool sites I maintain</h2>
    <p>Same maintainer, different niches—listed here only, not in every footer:</p>
    <ul>
      {
        siblingSitesForAbout.map((s) => (
          <li>
            <a href={s.url} rel="noopener noreferrer">
              {s.name}
            </a>{' '}
            — {s.niche}
          </li>
        ))
      }
    </ul>

    <h2>Found a mistake?</h2>
    <p>
      Email <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a> with the page URL, the
      number that looks wrong, and a link to the source that shows the right one. Confirmed fixes go in the
      <a href="/methodology/#changelog">correction log</a>.
    </p>
    <p class="meta-row">Last updated {siteConfig.contentUpdated}</p>
  </article>
</BaseLayout>
