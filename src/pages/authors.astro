---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Authors & Reviewers | YardCalc"
  description="Meet the YardCalc editorial team behind our home and garden material calculators and guides."
  canonicalPath="/authors/"
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Authors' }]} />
  <article class="container prose panel" style="margin:1rem auto 3rem;max-width:800px">
    <h1>Authors &amp; reviewers</h1>
    <p class="answer-first">
      Calculators and guides on {siteConfig.name} are maintained by {siteConfig.author.name}, with a focus on
      transparent DIY material math and citations—not anonymous auto-generated pages.
    </p>
    <h2>{siteConfig.author.name}</h2>
    <p><strong>{siteConfig.author.role}</strong></p>
    <p>{siteConfig.author.bio}</p>
    <p>
      For credentials updates or expert review offers, email
      <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
    </p>
    <p class="meta-row">Last updated {siteConfig.contentUpdated}</p>
  </article>
</BaseLayout>
