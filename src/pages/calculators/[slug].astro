---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import Calculator from '../../components/Calculator.astro';
import { siteConfig } from '../../config/site';
import { absoluteUrl, categories, getTool, tools } from '../../data/tools';
import { getGuide } from '../../data/guides';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
const tool = getTool(slug!);
if (!tool) throw new Error(`Unknown tool ${slug}`);

const cat = categories[tool.category];
const related = tool.relatedSlugs.map((s) => getTool(s)).filter(Boolean);
const relatedGuides = tool.relatedGuideSlugs.map((s) => getGuide(s)).filter(Boolean);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Calculators', item: absoluteUrl('/calculators/') },
      {
        '@type': 'ListItem',
        position: 3,
        name: cat.name,
        item: absoluteUrl(`/hubs/${cat.slug}/`),
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: tool.name,
        item: absoluteUrl(`/calculators/${tool.slug}/`),
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    description: tool.description,
    url: absoluteUrl(`/calculators/${tool.slug}/`),
    applicationCategory: tool.applicationCategory,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    provider: {
      '@type': 'Organization',
      name: siteConfig.name,
      url: siteConfig.siteUrl,
    },
    datePublished: tool.datePublished,
    dateModified: tool.dateModified,
  },
];
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  canonicalPath={`/calculators/${tool.slug}/`}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Calculators', href: '/calculators/' },
      { name: cat.name, href: `/hubs/${cat.slug}/` },
      { name: tool.shortName },
    ]}
  />
  <div class="container tool-layout">
    <section class="panel calc-panel">
      <h1>{tool.h1}</h1>
      <p class="answer-first">{tool.answerFirst}</p>
      <Calculator calculatorId={tool.calculatorId} />
      {
        tool.embeddable && (
          <p class="hint" style="margin-top:1rem">
            <a href={`/embed/${tool.slug}/`}>Embeddable widget</a> · state syncs to the URL for sharing
            (canonical stays on this clean URL).
          </p>
        )
      }
    </section>
    <aside class="panel">
      <h2>Related tools</h2>
      <div class="related">
        {
          related.map(
            (t) =>
              t && (
                <a class="tool-card" href={`/calculators/${t.slug}/`}>
                  <h3>{t.name}</h3>
                  <p>{t.summary}</p>
                </a>
              ),
          )
        }
      </div>
      <AdSlot position="mid" />
    </aside>
    <article class="panel tool-content prose">
      <Fragment set:html={tool.sectionsHtml} />
      <h2>FAQ</h2>
      {
        tool.faq.map((item) => (
          <>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </>
        ))
      }
      {
        relatedGuides.length > 0 && (
          <>
            <h2>Related guides</h2>
            <ul>
              {relatedGuides.map(
                (g) =>
                  g && (
                    <li>
                      <a href={`/guides/${g.slug}/`}>{g.h1}</a>
                    </li>
                  ),
              )}
            </ul>
          </>
        )
      }
      <h2>Sources</h2>
      <ul class="sources">
        {
          tool.sources.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="author-box">
        <p>
          <strong>{siteConfig.author.name}</strong> — {siteConfig.author.role}
        </p>
        <p>{siteConfig.author.bio}</p>
        <p class="meta-row">
          Published {tool.datePublished} · Last updated {tool.dateModified} ·
          <a href="/methodology/">Methodology</a>
        </p>
      </div>
    </article>
  </div>
</BaseLayout>
