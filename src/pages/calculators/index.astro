---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories, tools, absoluteUrl } from '../../data/tools';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Calculators', item: absoluteUrl('/calculators/') },
  ],
};
---

<BaseLayout
  title="All Home & Garden Calculators | YardCalc"
  description="Browse free concrete, mulch, gravel, fence, deck, roof, paint, and lawn calculators. US & metric units, no signup."
  canonicalPath="/calculators/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Calculators' }]} />
  <div class="container" style="padding-bottom:3rem">
    <h1>All calculators</h1>
    <p class="answer-first">
      Every YardCalc tool runs locally in your browser. Pick a calculator below or start from a
      <a href="/hubs/concrete/">topic hub</a>.
    </p>
    {
      Object.entries(categories).map(([key, cat]) => (
        <section style="margin-top:2rem">
          <h2>
            <a href={`/hubs/${cat.slug}/`}>{cat.name}</a>
          </h2>
          <div class="card-grid cols-3" style="margin-top:1rem">
            {tools
              .filter((t) => t.category === key)
              .map((t) => (
                <a class="tool-card" href={`/calculators/${t.slug}/`}>
                  <h3>{t.name}</h3>
                  <p>{t.summary}</p>
                </a>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
