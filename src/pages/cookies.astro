---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';
import { absoluteUrl } from '../data/tools';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Cookies', item: absoluteUrl('/cookies/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cookie Choices',
    description: `${siteConfig.name} cookie choices: analytics defaults by region, Reject / Do not sell or share opt-out, and how AdSense consent works in the EEA, UK, and Switzerland.`,
    url: absoluteUrl('/cookies/'),
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    dateModified: '2026-11-27',
  },
];
---

<BaseLayout
  title="Cookie Choices: Analytics & Ads"
  description={`${siteConfig.name} cookie choices: analytics by region, Reject / Do not sell or share opt-out, and AdSense consent in the EEA, UK, and Switzerland.`}
  canonicalPath="/cookies/"
  robots="noindex, follow"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Cookies' }]} />
  <article class="container prose panel" style="margin:1rem auto 3rem;max-width:800px">
    <h1>Cookie Choices</h1>
    <p class="answer-first">
      Outside the EEA, UK, and Switzerland, {siteConfig.name} grants analytics storage by default so traffic
      measurement works, while ad storage stays denied until you Accept. Use Reject / Do not sell or share to
      turn analytics (and ads) off and remember that choice. In the EEA, UK, and Switzerland, Google’s CMP
      handles consent instead.
    </p>
    <p>Last updated 2026-11-27</p>

    <h2>Your current preference</h2>
    <p id="cookie-pref-status" aria-live="polite">Checking saved choice…</p>
    <div class="btn-row" style="margin:1rem 0 1.5rem;flex-wrap:wrap;gap:0.75rem">
      <button type="button" class="btn btn-primary" id="cookie-page-accept">Accept analytics &amp; ads</button>
      <button type="button" class="btn btn-secondary" id="cookie-page-reject">Do not sell or share</button>
      <button type="button" class="btn btn-secondary" id="cookie-page-clear">Clear saved choice</button>
    </div>
    <p>
      Full policy detail lives on the <a href="/privacy/">privacy page</a>. Manufacturer and math notes are on
      <a href="/methodology/">methodology</a>.
    </p>

    <h2>How defaults work by region</h2>
    <ul>
      <li>
        <strong>EEA, United Kingdom, and Switzerland:</strong> Consent Mode defaults keep analytics and ad
        storage denied until Google’s certified CMP (Funding Choices / Privacy &amp; messaging) records a
        choice. The site cookie bar is not shown there.
      </li>
      <li>
        <strong>Other regions:</strong> analytics storage starts granted; ad storage stays denied until you
        Accept. Reject / Do not sell or share sets analytics and ad storage to denied and stores
        <code>yc_cookie_ok=0</code> in localStorage so later visits stay opted out.
      </li>
    </ul>

    <h2>What Accept vs Reject does</h2>
    <p>
      <strong>Accept</strong> grants analytics and ad-related Consent Mode signals (<code>analytics_storage</code>,
      <code>ad_storage</code>, <code>ad_user_data</code>, <code>ad_personalization</code>) and remembers
      <code>yc_cookie_ok=1</code>.
    </p>
    <p>
      <strong>Do not sell or share / Reject</strong> denies those same signals and remembers
      <code>yc_cookie_ok=0</code>. You can change your mind anytime on this page.
    </p>

    <h2>Personalized ads opt-out links</h2>
    <p>
      You can also manage Google personalized ads at
      <a href="https://www.google.com/settings/ads" rel="noopener">Ads Settings</a>
      or industry opt-outs at
      <a href="https://www.aboutads.info/choices/" rel="noopener">www.aboutads.info</a>.
    </p>
  </article>
  <script is:inline>
    (function () {
      var statusEl = document.getElementById('cookie-pref-status');
      var acceptBtn = document.getElementById('cookie-page-accept');
      var rejectBtn = document.getElementById('cookie-page-reject');
      var clearBtn = document.getElementById('cookie-page-clear');

      function readPref() {
        try {
          return localStorage.getItem('yc_cookie_ok');
        } catch (e) {
          return null;
        }
      }

      function renderStatus() {
        if (!statusEl) return;
        if (typeof window.__ytIsCmpRegion === 'function' && window.__ytIsCmpRegion()) {
          statusEl.textContent =
            'You appear to be in the EEA, UK, or Switzerland. Use Google’s on-page consent message; this site bar does not apply.';
          return;
        }
        var v = readPref();
        if (v === '1') {
          statusEl.textContent = 'Saved choice: Accept (analytics and ads granted).';
        } else if (v === '0') {
          statusEl.textContent = 'Saved choice: Do not sell or share (analytics and ads denied).';
        } else {
          statusEl.textContent =
            'No saved opt-out. Analytics is granted by default in your region; ads stay denied until Accept.';
        }
      }

      acceptBtn &&
        acceptBtn.addEventListener('click', function () {
          try {
            localStorage.setItem('yc_cookie_ok', '1');
          } catch (e) {}
          if (typeof window.__ycGrantConsent === 'function') window.__ycGrantConsent();
          renderStatus();
        });
      rejectBtn &&
        rejectBtn.addEventListener('click', function () {
          try {
            localStorage.setItem('yc_cookie_ok', '0');
          } catch (e) {}
          if (typeof window.__ycDenyConsent === 'function') window.__ycDenyConsent();
          renderStatus();
        });
      clearBtn &&
        clearBtn.addEventListener('click', function () {
          try {
            localStorage.removeItem('yc_cookie_ok');
          } catch (e) {}
          renderStatus();
        });

      renderStatus();
    })();
  </script>
</BaseLayout>
