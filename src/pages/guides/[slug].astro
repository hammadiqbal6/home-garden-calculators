---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { siteConfig } from '../../config/site';
import { absoluteUrl, getTool } from '../../data/tools';
import { getGuide, guides } from '../../data/guides';
import { personRef } from '../../lib/schema';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const guide = getGuide(Astro.params.slug!);
if (!guide) throw new Error('Unknown guide');
const relatedTools = guide.relatedToolSlugs.map((s) => getTool(s)).filter(Boolean);
const relatedGuides = (guide.relatedGuideSlugs || [])
  .map((s) => getGuide(s))
  .filter(Boolean);
const faqs = guide.faq || [];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: absoluteUrl('/guides/') },
      {
        '@type': 'ListItem',
        position: 3,
        name: guide.h1,
        item: absoluteUrl(`/guides/${guide.slug}/`),
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.h1,
    description: guide.description,
    datePublished: `${guide.datePublished}T00:00:00+05:00`,
    dateModified: `${guide.dateModified}T00:00:00+05:00`,
    author: [personRef()],
    publisher: {
      '@type': 'Organization',
      name: siteConfig.name,
      url: `${siteConfig.siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: new URL(siteConfig.logoPath, `${siteConfig.siteUrl}/`).toString(),
        width: 512,
        height: 512,
      },
    },
    mainEntityOfPage: absoluteUrl(`/guides/${guide.slug}/`),
  },
];

if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}
---

<BaseLayout
  title={`${guide.title} | YardCalc`}
  description={guide.description}
  canonicalPath={`/guides/${guide.slug}/`}
  ogType="article"
  jsonLd={jsonLd}
  ogImagePath={`/og/guide-${guide.slug}.svg`}
  ogImageAlt={`${guide.h1} — YardCalc`}
>
  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Guides', href: '/guides/' },
      { name: guide.h1 },
    ]}
  />
  <article class="container prose panel" style="margin:1rem auto 3rem; max-width:800px">
    <h1>{guide.h1}</h1>
    <p class="answer-first">{guide.answerFirst}</p>
    <p class="meta-row">
      By <a href={siteConfig.author.urlPath} rel="author">{siteConfig.author.name}</a>
      · Published {guide.datePublished} · Last reviewed {guide.dateModified}
    </p>
    <Fragment set:html={guide.bodyHtml} />
    {
      faqs.length > 0 && (
        <>
          <h2>FAQ</h2>
          {faqs.map((item) => (
            <>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </>
          ))}
        </>
      )
    }
    <h2>Related calculators</h2>
    <ul>
      {
        relatedTools.map(
          (t) =>
            t && (
              <li>
                <a href={`/calculators/${t.slug}/`}>{t.name}</a> — {t.summary}
              </li>
            ),
        )
      }
    </ul>
    {
      relatedGuides.length > 0 && (
        <>
          <h2>Related guides</h2>
          <ul>
            {relatedGuides.map(
              (g) =>
                g && (
                  <li>
                    <a href={`/guides/${g.slug}/`}>{g.h1}</a>
                  </li>
                ),
            )}
          </ul>
        </>
      )
    }
    <div class="author-box">
      <p>
        Built and maintained by
        <a href={siteConfig.author.urlPath} rel="author">{siteConfig.author.name}</a>
        — {siteConfig.author.role}
      </p>
      <p>{siteConfig.author.bio}</p>
      <p>
        <a href="/about/#maintainer">About the maintainer</a> ·
        <a href="/methodology/">Methodology</a>
      </p>
    </div>
  </article>
</BaseLayout>
