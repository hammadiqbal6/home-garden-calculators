---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides } from '../../data/guides';
import { absoluteUrl } from '../../data/tools';
---

<BaseLayout
  title="Home & Garden Guides | YardCalc"
  description="Practical guides on concrete bags, mulch depth, driveway gravel, and measuring roof pitch—paired with free calculators."
  canonicalPath="/guides/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: absoluteUrl('/guides/') },
    ],
  }}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides' }]} />
  <div class="container" style="padding-bottom:3rem">
    <h1>Guides</h1>
    <p class="answer-first">
      Short, cited explainers that answer common project questions and link to the matching YardCalc tools.
    </p>
    <div class="card-grid" style="margin-top:1.5rem">
      {
        guides.map((g) => (
          <a class="tool-card" href={`/guides/${g.slug}/`}>
            <h2>{g.h1}</h2>
            <p>{g.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
