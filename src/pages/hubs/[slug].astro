---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absoluteUrl, categories, tools, type ToolCategory } from '../../data/tools';
import { guides } from '../../data/guides';

export function getStaticPaths() {
  return Object.values(categories).map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const entry = Object.entries(categories).find(([, c]) => c.slug === slug);
if (!entry) throw new Error('Unknown hub');
const [catKey, cat] = entry;
const hubTools = tools.filter((t) => t.category === (catKey as ToolCategory));
const hubGuides = guides.filter((g) =>
  g.relatedToolSlugs.some((s) => hubTools.some((t) => t.slug === s)),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: cat.name, item: absoluteUrl(`/hubs/${cat.slug}/`) },
  ],
};
---

<BaseLayout
  title={`${cat.name} | YardCalc`}
  description={cat.description}
  canonicalPath={`/hubs/${cat.slug}/`}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: cat.name }]} />
  <div class="container" style="padding-bottom:3rem">
    <h1>{cat.name}</h1>
    <p class="answer-first">{cat.description} Primary topic focus: {cat.primaryKeyword}.</p>
    <h2>Calculators in this hub</h2>
    <div class="card-grid cols-3" style="margin-top:1rem">
      {
        hubTools.map((t) => (
          <a class="tool-card" href={`/calculators/${t.slug}/`}>
            <h3>{t.name}</h3>
            <p>{t.summary}</p>
          </a>
        ))
      }
    </div>
    {
      hubGuides.length > 0 && (
        <>
          <h2 style="margin-top:2rem">Related guides</h2>
          <div class="card-grid" style="margin-top:1rem">
            {hubGuides.map((g) => (
              <a class="tool-card" href={`/guides/${g.slug}/`}>
                <h3>{g.h1}</h3>
                <p>{g.answerFirst.slice(0, 120)}…</p>
              </a>
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
