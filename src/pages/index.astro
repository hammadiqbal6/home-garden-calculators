---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { categories, tools } from '../data/tools';
import { guides } from '../data/guides';
import { homeGraph } from '../lib/schema';

const featured = [
  'concrete-calculator',
  'concrete-calculator-post-holes',
  'sonotube-concrete-calculator',
  'mulch-calculator',
  'mulch-calculator-tree-rings',
  'gravel-calculator',
  'fence-calculator',
  'deck-material-calculator',
  'roof-pitch-calculator',
  'roofing-shingles-calculator',
  'paint-calculator',
  'retaining-wall-calculator',
].map((s) => tools.find((t) => t.slug === s)!);

const jsonLd = [homeGraph()];
---

<BaseLayout
  title={`${siteConfig.name} – Free Home & Garden Material Calculators`}
  description="Free concrete, mulch, gravel, fence, deck, roof pitch, paint, and landscape calculators. US & metric units, bag counts, and guides—no signup."
  canonicalPath="/"
  jsonLd={jsonLd}
  ogImagePath="/og/home.svg"
  ogImageAlt="YardCalc — free home and garden material calculators"
>
  <section class="hero container">
    <p class="brand" style="margin:0 0 0.75rem;font-size:1.35rem">
      <span class="brand-mark" aria-hidden="true">Y</span> {siteConfig.name}
    </p>
    <h1>Free home &amp; garden material calculators</h1>
    <p class="lede answer-first">
      YardCalc estimates concrete bags, mulch yards, gravel tons, grass seed, fertilizer, paint, and outdoor
      materials from simple dimensions. Enter length, width, and depth (or area and rate) for cubic yards,
      bags, or product pounds in US or metric units. Math runs privately in your browser—confirm bag yields,
      local codes, and product labels before you buy.
    </p>
    <p class="meta-row" style="margin-top:0.5rem">Updated {siteConfig.contentUpdated}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/concrete-calculator/">Concrete calculator</a>
      <a class="btn btn-secondary" href="/calculators/">Browse all tools</a>
    </div>
  </section>

  <section class="container" style="padding-bottom:2rem">
    <h2>Popular calculators</h2>
    <div class="card-grid cols-3" style="margin-top:1rem">
      {
        featured.slice(0, 5).map((t) => (
          <a class="tool-card" href={`/calculators/${t.slug}/`}>
            <h3>{t.name}</h3>
            <p>{t.summary}</p>
          </a>
        ))
      }
    </div>
    <p style="margin-top:1rem">
      <a href="/calculators/">Browse all {tools.length} calculators →</a>
    </p>
  </section>

  <section class="container" style="padding-bottom:2rem">
    <h2>Browse by project type</h2>
    <div class="card-grid" style="margin-top:1rem">
      {
        Object.values(categories).map((c) => (
          <a class="tool-card" href={`/hubs/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container" style="padding-bottom:3rem">
    <h2>Guides</h2>
    <div class="card-grid" style="margin-top:1rem">
      {
        guides.map((g) => (
          <a class="tool-card" href={`/guides/${g.slug}/`}>
            <h3>{g.h1}</h3>
            <p>{g.answerFirst.slice(0, 140)}…</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
