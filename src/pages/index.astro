---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { categories, tools } from '../data/tools';
import { guides } from '../data/guides';
import { homeGraph, collectionPageJsonLd } from '../lib/schema';

const popularTools = [
  { name: 'Concrete calculator', path: '/calculators/concrete-calculator/' },
  { name: 'Mulch calculator', path: '/calculators/mulch-calculator/' },
  { name: 'Gravel calculator', path: '/calculators/gravel-calculator/' },
  { name: 'Paver calculator', path: '/calculators/paver-calculator/' },
  { name: 'Fence calculator', path: '/calculators/fence-calculator/' },
  { name: 'Deck material calculator', path: '/calculators/deck-material-calculator/' },
];

const jsonLd = [
  homeGraph(),
  collectionPageJsonLd({
    name: 'Free Home & Garden Calculators (Concrete, Mulch)',
    description:
      'Popular YardTally calculators for concrete, mulch, gravel, pavers, fence, and deck materials—yards, bags, and piece counts from simple dimensions.',
    path: '/',
    items: popularTools,
  }),
];
---

<BaseLayout
  title="Free Home & Garden Calculators (Concrete, Mulch)"
  description="Free concrete, mulch, gravel, fence, deck, roof pitch, paint, and landscape calculators. US & metric units, bag counts, and guides—no signup."
  canonicalPath="/"
  jsonLd={jsonLd}
  ogImagePath="/og/home.png"
  ogImageAlt={siteConfig.defaultOgImageAlt}
>
  <section class="hero container">
    <p class="brand" style="margin:0 0 0.75rem;font-size:1.35rem">
      <span class="brand-mark" aria-hidden="true">Y</span> {siteConfig.name}
    </p>
    <h1>Free home &amp; garden material calculators</h1>
    <p class="lede answer-first">
      {siteConfig.name} estimates
      <a href="/calculators/concrete-calculator/">concrete</a> bags,
      <a href="/calculators/mulch-calculator/">mulch</a> yards,
      <a href="/calculators/gravel-calculator/">gravel</a> tons,
      <a href="/calculators/paver-calculator/">paver</a> counts,
      <a href="/calculators/fence-calculator/">fence</a> posts, and
      <a href="/calculators/deck-material-calculator/">deck</a> boards from simple dimensions.
      Enter length, width, and depth (or area and rate) for cubic yards, bags, or product pounds in US or metric
      units. Math runs privately in your browser—confirm bag yields, local codes, and product labels before you buy.
    </p>
    <p class="meta-row" style="margin-top:0.5rem">Updated {siteConfig.contentUpdated}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/concrete-calculator/">Concrete calculator (yards &amp; bags)</a>
      <a class="btn btn-secondary" href="/calculators/sonotube-concrete-calculator/">Sonotube concrete calculator</a>
      <a class="btn btn-secondary" href="/calculators/">Browse all tools</a>
    </div>
  </section>

  <section class="container" style="padding-bottom:2rem">
    <h2>All {tools.length} calculators</h2>
    <p style="margin-top:0.5rem;max-width:42rem">
      Every tool is linked below by project type. Popular concrete starters:
      <a href="/calculators/concrete-calculator/">concrete calculator for slabs in yards and bags</a>,
      <a href="/calculators/concrete-steps-calculator/">concrete steps calculator</a>,
      <a href="/calculators/concrete-footing-calculator/">concrete footing calculator</a>,
      <a href="/calculators/concrete-slab-cost-calculator/">concrete slab cost calculator</a>,
      <a href="/calculators/sonotube-concrete-calculator/">Sonotube concrete calculator (bags by diameter)</a>,
      <a href="/calculators/deck-footing-calculator/">deck footing calculator</a>,
      <a href="/guides/how-much-concrete-do-i-need/">how much concrete do I need</a>,
      <a href="/guides/concrete-slab-thickness/">concrete slab thickness</a>,
      <a href="/guides/sonotube-footing-and-depth/">Sonotube footing and depth</a>,
      <a href="/guides/how-many-bags-of-concrete/">how many bags of concrete</a>,
      and the <a href="/hubs/concrete/">concrete calculators hub</a>.
      Landscape: <a href="/calculators/mulch-calculator/">how much mulch do I need</a>,
      <a href="/calculators/mulch-calculator-circular-beds/">circular bed mulch calculator</a>,
      <a href="/calculators/paver-base-calculator/">paver base calculator</a>,
      <a href="/calculators/french-drain-gravel-calculator/">French drain gravel calculator</a>,
      and the <a href="/hubs/landscape/">landscape calculators hub</a>.
      Lawn: <a href="/calculators/grass-seed-calculator/">grass seed calculator</a>,
      <a href="/calculators/sod-calculator/">sod calculator</a>,
      <a href="/calculators/fertilizer-calculator/">lawn fertilizer calculator</a>,
      <a href="/guides/grass-seed-per-sq-ft/">grass seed density / rates</a>,
      and the <a href="/hubs/lawn/">lawn calculators hub</a>.
      Outdoor framing: <a href="/calculators/lumber-calculator/">dimensional lumber weight calculator</a>,
      <a href="/guides/lumber-weight-chart/">lumber weight per foot chart</a>,
      <a href="/calculators/brick-calculator/">brick estimator</a>,
      and <a href="/guides/how-much-paint-for-a-room/">how much paint for a room</a>.
      Driveways: <a href="/calculators/asphalt-calculator/">asphalt / blacktop calculator</a>,
      <a href="/guides/gravel-types-for-driveways/">gravel types for driveways</a>.
      Fence posts: <a href="/guides/how-much-concrete-for-fence-posts/">how much concrete for each fence post</a>.
    </p>
    <p style="margin-top:0.75rem;max-width:42rem">
      Each calculator shows the formula, a worked example with bag or piece counts, and cited sources (manufacturer
      TDS or university extension). Math runs in your browser—shareable URLs keep inputs in the query string while
      the canonical tag stays on the clean page path. Start from a hub if you are not sure which shape or material
      tool fits the job.
    </p>
  </section>

  {
    Object.entries(categories).map(([key, cat]) => (
      <section class="container" style="padding-bottom:1.5rem">
        <h2 style="font-size:1.25rem;margin:0">
          <a href={`/hubs/${cat.slug}/`}>{cat.name}</a>
        </h2>
        <div class="card-grid cols-3" style="margin-top:0.75rem">
          {tools
            .filter((t) => t.category === key)
            .map((t) => (
              <a class="tool-card" href={`/calculators/${t.slug}/`}>
                <h3>{t.name}</h3>
                <p>{t.summary}</p>
              </a>
            ))}
        </div>
      </section>
    ))
  }

  <section class="container" style="padding-bottom:2rem">
    <p>
      <a href="/calculators/">Browse the full calculators index →</a>
    </p>
  </section>

  <section class="container" style="padding-bottom:2rem">
    <h2>Browse by project type</h2>
    <div class="card-grid" style="margin-top:1rem">
      {
        Object.values(categories).map((c) => (
          <a class="tool-card" href={`/hubs/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container" style="padding-bottom:3rem">
    <h2>Guides</h2>
    <div class="card-grid" style="margin-top:1rem">
      {
        guides.map((g) => (
          <a class="tool-card" href={`/guides/${g.slug}/`}>
            <h3>{g.h1}</h3>
            <p>{g.answerFirst.slice(0, 140)}…</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
