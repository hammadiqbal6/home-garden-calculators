---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';
import { absoluteUrl } from '../data/tools';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Terms', item: absoluteUrl('/terms/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Terms of Use',
    description:
      `${siteConfig.name} terms of use for free home and garden calculators and guides. Results are estimates only.`,
    url: absoluteUrl('/terms/'),
    isPartOf: { '@id': `${absoluteUrl('/')}#website` },
    dateModified: siteConfig.contentUpdated,
  },
];
---

<BaseLayout
  title={`Terms of Use for ${siteConfig.name} Calculators and Guides`}
  description={`${siteConfig.name} terms of use for free home and garden calculators and guides. Results are estimates only—verify with professionals, labels, and local codes.`}
  canonicalPath="/terms/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Terms' }]} />
  <article class="container prose panel" style="margin:1rem auto 3rem;max-width:800px">
    <h1>Terms of Use</h1>
    <p class="answer-first">
      {siteConfig.name} provides free estimation tools and educational content. Results are approximate aids—not
      engineering, architectural, or legal advice. Verify materials with manufacturers, suppliers, and local
      building codes before you buy or build.
    </p>
    <p class="meta-row">Last updated {siteConfig.contentUpdated}</p>
    <h2>License to use</h2>
    <p>
      You may use the calculators for personal and professional estimating at no charge. You may link to any
      public page. Embeddable widgets (where offered) may be framed on other sites only when the visible
      credit link back to the matching {siteConfig.name} calculator page remains intact and conspicuous. Do not
      scrape, bulk-download, or automate access in a way that degrades service or violates applicable law.
    </p>
    <h2>Accuracy and responsibility</h2>
    <p>
      Formulas are documented on each tool page and in the <a href="/methodology/">methodology</a> notes, but
      bag yields, rock densities, seed rates, waste factors, and codes vary by product and location. Regional
      frost depth, soil type, and manufacturer specialty mixes can change real material needs. You assume
      responsibility for purchasing decisions, structural safety, and compliance with local rules. When in
      doubt, hire a licensed professional.
    </p>
    <h2>User conduct</h2>
    <p>
      Do not use the site to distribute malware, attempt unauthorized access to hosting infrastructure, or
      submit abusive or unlawful content through the contact channels. We may refuse or ignore messages that
      request fabricated testimonials, fake credentials, or policy circumvention.
    </p>
    <h2>Disclaimer</h2>
    <p>
      The site is provided “as is” without warranties of merchantability or fitness for a particular purpose.
      To the extent permitted by law, {siteConfig.name} and its maintainer are not liable for indirect,
      incidental, or consequential damages arising from use of the tools or guides, including over- or
      under-ordering of materials.
    </p>
    <h2>Intellectual property</h2>
    <p>
      Site design, original explanatory text, and calculator interfaces are owned by the maintainer unless
      otherwise noted. Manufacturer names and trademarks (for example QUIKRETE, Sakrete, Sonotube) belong to
      their owners and are cited only as sources; no affiliation or endorsement is implied.
    </p>
    <h2>Privacy and analytics</h2>
    <p>
      Calculator inputs are processed in your browser. Optional analytics cookies load only after consent. See
      the <a href="/privacy/">privacy policy</a> for details on Google Analytics, AdSense, and opt-out links.
    </p>
    <h2>Changes</h2>
    <p>
      These terms may be updated when features, advertising status, or legal requirements change. The “Last
      updated” date on this page reflects the current version.
    </p>
    <h2>Contact</h2>
    <p>
      Questions about these terms: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      or the <a href="/contact/">contact page</a>.
    </p>
  </article>
</BaseLayout>
